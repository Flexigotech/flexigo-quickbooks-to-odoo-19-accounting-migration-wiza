<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- FR-006: QuickBooks Connection Views -->

    <!-- List View -->
    <record id="view_qb_connection_list" model="ir.ui.view">
        <field name="name">qb.connection.list</field>
        <field name="model">qb.connection</field>
        <field name="arch" type="xml">
            <tree string="QuickBooks Connections">
                <field name="name"/>
                <field name="connection_type"/>
                <field name="is_sandbox"/>
                <field name="fgt_route"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_qb_connection_form" model="ir.ui.view">
        <field name="name">qb.connection.form</field>
        <field name="model">qb.connection</field>
        <field name="arch" type="xml">
            <form string="QuickBooks Connection">
                <header>
                    <button name="action_connect_qbo" type="object" string="Connect to QuickBooks Online"
                            class="btn-primary" invisible="connection_type != 'oauth'"/>
                    <button name="action_test_connection" type="object" string="Test Connection"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="connection_type"/>
                            <field name="is_sandbox"/>
                            <field name="fgt_route"/>
                        </group>
                        <group invisible="connection_type != 'oauth'">
                            <field name="oauth_client_id"/>
                            <field name="oauth_client_secret_encrypted" string="Client Secret" password="True"
                                   invisible="fgt_route != 'direct'"/>
                            <field name="fgt_consent" invisible="fgt_route == 'direct'"/>
                            <field name="fgt_client_secret" password="True" invisible="fgt_route == 'direct'"/>
                            <field name="fgt_saved_at" invisible="fgt_route == 'direct' or not fgt_saved_at"/>
                            <field name="fgt_connected_on" invisible="fgt_route == 'direct' or not fgt_connected_on"/>
                            <field name="oauth_redirect_uri" widget="CopyClipboardChar"/>
                            <field name="realm_id" readonly="1"/>
                            <field name="minorversion"/>
                        </group>
                        <group invisible="connection_type != 'upload'">
                            <field name="qbdt_file" filename="qbdt_filename"/>
                            <field name="qbdt_filename" invisible="1"/>
                            <field name="validation_message" readonly="1" invisible="not validation_message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- the staging of a loaded project can be deleted (Migration Managers) -->
    <record id="view_migration_project_form_qb" model="ir.ui.view">
        <field name="name">migration.project.form.quickbooks</field>
        <field name="model">migration.project</field>
        <field name="inherit_id" ref="flexigo_migration_base.view_migration_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_qb_delete_staging" type="object" string="Delete Staging"
                            groups="flexigo_migration_base.group_migration_manager"
                            invisible="status not in ('loaded', 'reconciled', 'live')"
                            confirm="Delete the staging of this project, with the personal data of the QuickBooks customers and vendors in it? What was loaded into Odoo stays; Extract fills the staging again."/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- reviewers sign off the reconciliation -->
    <record id="view_migration_reconciliation_form_qb" model="ir.ui.view">
        <field name="name">migration.reconciliation.form.quickbooks</field>
        <field name="model">migration.reconciliation</field>
        <field name="inherit_id" ref="flexigo_migration_base.view_migration_reconciliation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_qb_sign_off" type="object" string="Sign Off" class="btn-primary"
                            groups="flexigo_quickbooks_to_odoo_19_accounting_migration_wiza.group_migration_reviewer"
                            invisible="signed_off"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Action -->
    <record id="action_qb_connection" model="ir.actions.act_window">
        <field name="name">QuickBooks Connections</field>
        <field name="res_model">qb.connection</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- the staging: what Extract brought, to look at (and export) before Load writes anything -->
    <record id="action_qb_staging" model="ir.actions.act_window">
        <field name="name">Staging</field>
        <field name="res_model">migration.staging.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qb_staging" name="Staging" parent="flexigo_migration_base.menu_migration_root"
              action="action_qb_staging" sequence="45"/>

    <menuitem id="menu_qb_connections" name="QuickBooks Connections" parent="flexigo_migration_base.menu_migration_root"
              action="action_qb_connection" sequence="50" groups="flexigo_migration_base.group_migration_manager"/>

</odoo>
