    <!-- Migration Manager: full CRUD on all migration models (implied_ids per ODOO19-009) -->
    <record id="group_migration_manager" model="res.groups">
        <field name="name">QuickBooks Migration / Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Migration Reviewer: read access on project, staging, validation results, reconciliation (implied_ids per ODOO19-009) -->
    <record id="group_migration_reviewer" model="res.groups">
        <field name="name">QuickBooks Migration / Reviewer</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
